# Shared across apps/website, apps/dashboard, apps/extension.
# The frontend never holds keys or talks to Stellar directly for privileged
# actions — everything privileged flows through astraguard-backend's oracle.

# Base URL of astraguard-backend's public API (see openapi.yaml in that repo)
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket endpoint for live score subscriptions (dashboard project pages)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Stellar network the badge/extension display status for (testnet | mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
